# Daniela Kellner / FLUSSwärts – statischer Export für world4you
# SSL zuerst im Kundenbereich aktivieren, danach dort HTTPS erzwingen.
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType audio/mpeg .mp3
  AddType font/ttf .ttf
</IfModule>

# Aktualisierte Texte, Skripte und Styles beim nächsten Aufruf neu prüfen.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Frühere WordPress-Adressen dauerhaft auf die passenden neuen Inhalte führen.
# Exakte Pfade verhindern, dass neue Angebotsseiten erneut umgeleitet werden.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/angebot/moxa/?$ https://shiatsu-kellner.at/angebote/moxa-narbenarbeit/
  RedirectMatch 301 ^/angebot/shiatsu/?$ https://shiatsu-kellner.at/angebote/shiatsu/
  RedirectMatch 301 ^/angebot/quantenarbeit/?$ https://shiatsu-kellner.at/angebote/mentaltraining-coaching/
  RedirectMatch 301 ^/angebot/workshops/?$ https://shiatsu-kellner.at/#begegnungen
  RedirectMatch 301 ^/praxis/?$ https://shiatsu-kellner.at/#kontakt
  RedirectMatch 301 ^/daniela/?$ https://shiatsu-kellner.at/#daniela
  RedirectMatch 301 ^/kontakt/?$ https://shiatsu-kellner.at/#kontakt
  RedirectMatch 301 ^/testimonials/?$ https://shiatsu-kellner.at/#stimmen
</IfModule>
